# API credentials are optional for harness setup, required for the corresponding API workflow.
# Supply through the process environment or the ignored harness-root .env file.
# Attio workspace API token; never commit its value.
ATTIO_API_KEY=
# Granola API key with access to the requested notes; never commit its value.
GRANOLA_API_KEY=

# Portable session continuation. All five settings below are required for save/resume.
# Load values into the process environment; the CLI does not load .env automatically.
# HTTPS project URL for the provisioned Harness continuation backend.
HARNESS_CONTINUATION_SUPABASE_URL=
# Service-role key from external secret custody. Never expose it to agent prompts.
HARNESS_CONTINUATION_SUPABASE_SERVICE_ROLE_KEY=
# Canonical base64 for at least 32 random bytes. Generate once; reuse on every machine.
HARNESS_CONTINUATION_KEY_BASE64=
# Shared age access for continuation and secure records.
# Path to a protected identity file outside the repository, not the private key itself.
# Save also needs this identity for the encrypted retry queue.
HARNESS_SECURE_AGE_IDENTITY=
# Comma-separated, distinct primary and recovery public recipients.
HARNESS_SECURE_AGE_RECIPIENTS=

# Optional overrides stay commented to preserve defaults and existing exports.
# Uncomment a setting only after supplying a value.
# Secure-record directory override; the default is .secure-documents/.
# HARNESS_SECURE_DOCUMENTS_DIR=

# Bitwarden custody session. Leave unset to unlock interactively per command.
# HARNESS_BITWARDEN_SESSION=
# BW_SESSION is an alternative supported by the Bitwarden CLI.
# BW_SESSION=
# Optional protected session-file override. `pnpm secure:login` uses a user-scoped temp file by default.
# HARNESS_BITWARDEN_SESSION_FILE=

# Set to 0 to disable the optional session optimization hook.
# HARNESS_OPTIMIZATION_ENABLED=0

# HCP Terraform control-plane operations only; required for provider writes.
# Supply through the protected workspace variable store or external secret store.
TFE_TOKEN=
# Required for infrastructure/hcp initialization/import; private organization metadata.
TF_VAR_tfe_organization=
# Optional, only for importing an existing repository workspace by name.
PROJECT_WORKSPACE_NAME=
