{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(!**/.env.example)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.env)",
      "Edit(!**/.env.example)",
      "Read(./.secure-documents/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/git-guard.mjs\"" }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/default-clone-guard.mjs\"" }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } },
    "impeccable": { "source": { "source": "github", "repo": "pbakaus/impeccable" } }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "vercel@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "impeccable@impeccable": true
  }
}
